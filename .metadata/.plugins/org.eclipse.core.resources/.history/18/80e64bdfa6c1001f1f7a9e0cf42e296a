package edu.pnu;

import org.springframework.boot.ApplicationArguments;
import org.springframework.boot.ApplicationRunner;
import org.springframework.stereotype.Component;

import edu.pnu.domain.Community;
import edu.pnu.domain.Member;
import edu.pnu.persistence.CommunityRepository;
import lombok.RequiredArgsConstructor;

@Component
@RequiredArgsConstructor
public class CommunityTestData implements ApplicationRunner{
	private final CommunityRepository commuRepo;
	
	@Override
	public void run(ApplicationArguments args) throws Exception {
		String s[] = {"홍길동"};
		for (int i = 1; i <= 10; i++) {
			
			// Member 객체를 생성하고 NickName 설정
            Member nickName = new Member();
            nickName.setNickName(s[0]);
            
			commuRepo.save(Community.builder()
					.title("title" + (i+1))
					.content("content" + (i+1))
					.member(nickName) 
					.likes(i+1)
					.dislike(i+1)
					.hit(i+1)
					.build());
		}
		
	}
}
