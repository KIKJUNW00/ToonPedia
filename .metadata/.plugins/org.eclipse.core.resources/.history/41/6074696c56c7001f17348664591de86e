package edu.pnu.service;

import java.util.List;

import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;

import edu.pnu.domain.Community;
import edu.pnu.persistence.CommunityRepository;
import edu.pnu.persistence.MemberRepository;
import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class CommunityService {
	private final CommunityRepository commuRepo;
	private final MemberRepository memRepo;
	
	//커뮤니티 게시판 데이터 모두 불러오기
	public List<Community> getBoards() {
		return commuRepo.findAll();
	}
	
	//id별 게시판 데이터 불러오기(게시글 상세보기+조회수up)
	public Community getBoard(Long id) {
		Community community = commuRepo.findById(id).get();
		
		community.setHit(community.getHit()+1);
		
		return commuRepo.save(community);
	}
	
	//게시판 글쓰기
	public void insertBoard(Long memberId,Community community) {
		
		 // Member ID로 작성자의 nickname 조회
        String nickname = memRepo.findById(memberId)
                .orElseThrow(() -> new IllegalArgumentException("Member not found"))
                .getNickname();
     // Community 객체에 nickname 설정
        community.setNickname(nickname);
        
		commuRepo.save(community);
	}
	
	
}
