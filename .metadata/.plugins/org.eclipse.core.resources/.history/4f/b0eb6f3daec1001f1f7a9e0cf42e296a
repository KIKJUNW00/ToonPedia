package edu.pnu;

import org.springframework.boot.ApplicationArguments;
import org.springframework.boot.ApplicationRunner;
import org.springframework.http.HttpHeaders;
import org.springframework.stereotype.Component;

import edu.pnu.domain.Community;
import edu.pnu.domain.Member;
import edu.pnu.persistence.CommunityRepository;
import edu.pnu.persistence.MemberRepository;
import edu.pnu.util.JWTUtil;
import lombok.RequiredArgsConstructor;

@Component
@RequiredArgsConstructor
public class CommunityTestData implements ApplicationRunner{
	private final CommunityRepository commuRepo;
	private final MemberRepository memRepo;
	
	@Override
	public void onAuthenticationSuccess(HttpServletRequest request, HttpServletResponse response,
	        Authentication authentication) throws IOException, ServletException {

	    log.info("OAuth2SuccessHandler:onAuthenticationSuccess");

	    // OAuth2User 객체에서 구글 로그인 정보를 가져옴
	    OAuth2User user = (OAuth2User) authentication.getPrincipal(); 
	    
	    // 구글에서 사용자 정보 가져오기
	    String snsid = CustomMyUtil.getUsernameFromOAuth2User(user);  // SNS ID
	    String name = (String) user.getAttributes().get("name");       // 사용자 이름 (실제 이름)
	    
	    // 사용자 정보가 없으면 예외 처리
	    if (snsid == null || name == null) {
	        log.error("onAuthenticationSuccess: Cannot retrieve snsId or name from oauth2user!");
	        throw new ServletException("Cannot retrieve snsId or name from oauth2user!");
	    }

	    log.info("Google User SNS ID: " + snsid);
	    log.info("Google User Name: " + name);

	    // Member 객체를 생성하고 저장
	    Member member = memRepo.save(Member.builder()
	            .snsId(snsid)       // SNS ID 저장
	            .nickName(name)     // 사용자 이름을 닉네임으로 사용
	            .role(Role.ROLE_USER) // 기본 역할을 ROLE_USER로 설정
	            .build());

	    // Community 객체를 생성하고 저장
	    for (int i = 0; i < 10; i++) {
	        commuRepo.save(Community.builder()
	                .title("title" + (i + 1))
	                .content("content" + (i + 1))
	                .member(member)  // 저장된 Member 객체를 참조
	                .likes(i + 1)
	                .dislike(i + 1)
	                .hit(i + 1)
	                .build());
	    }

	    // JWT 토큰 생성
	    String jwtToken = JWTUtil.getJWT(snsid);
	    
	    // JWT 토큰을 응답 헤더에 추가
	    response.addHeader(HttpHeaders.AUTHORIZATION, jwtToken);
	    
	    // 로그인 후 이동할 URL 설정 (예: 홈 페이지로 리디렉션)
	    super.onAuthenticationSuccess(request, response, authentication);
	}

		
	
}
